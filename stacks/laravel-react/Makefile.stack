# Stack: Laravel + React
deps:
	composer install --no-interaction --prefer-dist
	@if [ -f package-lock.json ]; then npm ci; else npm install; fi

dev:
	npm run dev   # jalankan 'php artisan serve' di terminal lain

test:
	php artisan test
	npm test --if-present

lint:
	./vendor/bin/pint --test
	npm run lint --if-present

build:
	npm run build
