# Contoh target Makefile untuk Laravel + React. Sesuaikan dengan proyekmu.

setup:
	git config core.hooksPath scripts/hooks
	chmod +x scripts/hooks/* scripts/*.sh
	composer install
	npm ci

dev:
	npm run dev   # jalankan 'php artisan serve' di terminal lain

test:
	php artisan test
	npm test --if-present

lint:
	./vendor/bin/pint --test
	npm run lint --if-present

build:
	npm run build
